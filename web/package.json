{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"dev:all": "bash ../scripts/dev-all.sh --web",
		"dev:all:web": "bash ../scripts/dev-all.sh --web",
		"dev:all:ios": "bash ../scripts/dev-all.sh --ios",
		"dev:all:ios:iphone16": "bash ../scripts/dev-all.sh --ios --ios-device \"iPhone 16\"",
		"dev:all:ios:mockhr": "bash ../scripts/dev-all.sh --ios --ios-mock-heart-rate",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.6",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"chart.js": "^4.5.1"
	}
}
